# Arc Testnet (chain 5042002)
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
ARC_TESTNET_PK=            # throwaway testnet key (see docs/keys-needed.md)
# ERC-8183 reference (already deployed on Arc testnet)
ERC8183_ADDR=0x0747EEf0706327138c69792bF28Cd525089e4583
# USDC ERC-20 on Arc testnet (6 decimals) — native gas is 18 decimals, same balance
USDC_ADDR=0x3600000000000000000000000000000000000000
POLICY_WALLET_ADDR=        # filled after Task 2 deploy
AGENT_ADDR=                # agent key addr for PolicyWallet constructor (withdrawal caller; falls back to ARC_RECIPIENT_ADDR)
# The Graph
GRAPH_GATEWAY_KEY=         # Subgraph Studio key (queries + MCP auth)
GRAPH_STUDIO_DEPLOY_KEY=   # Studio deploy key for openbook-pnl
SELLER_ADDRESS=            # operator/seller address — openbook-pnl subgraph books P&L only for this job provider (deploy-subgraph.sh substitutes it)
# ENS (Sepolia, ENSv2)
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_PK=                # treasury EOA (name owner = treasury admin)
TREASURY_EOA=              # address of SEPOLIA_PK — name owner / resolver deployer; derived from PK if empty
OPENBOOK_NAME=openbook.eth
ENS_COMMIT_SECRET=         # printed by scripts/ens/setup.sh stage 3 — save before the reveal
ENS_RESOLVER=              # predicted OwnedResolver (printed by setup.sh stage 2) — needed to resume --from 3+
# Agent
AGENT_ID=                  # ERC-8004 agent id after registration
AGENT_METADATA_URI=        # pinned ERC-8004 metadata JSON (IPFS preferred; stored onchain as tokenURI)
MIRROR_TO_SEPOLIA=false    # shadow-ledger fallback flag

# ERC-8004 identity registration (Task 3 — optional Circle path; cast-send works without these)
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
CIRCLE_API_KEY=            # console.circle.com -> Keys (Standard key) — dev-controlled wallets
CIRCLE_ENTITY_SECRET=      # console.circle.com/wallets/dev/configurator/entity-secret
CIRCLE_WALLET_SET_ID=      # optional: reuse an existing dev-controlled wallet set
CIRCLE_WALLET_ID=          # optional: reuse an existing dev-controlled wallet (SCA)
CIRCLE_WALLET_ADDRESS=     # optional: reuse an existing dev-controlled wallet address
