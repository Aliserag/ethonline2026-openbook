# OpenBook frontend env — copy to app/.env.local and fill in real values.
# Vite only exposes VITE_-prefixed keys to the client bundle; anything else is inert.

# The Graph Subgraph Studio key — REQUIRED for the delivery query and the P&L table
# (Gateway + openbook-pnl Studio query are key-gated, like every The Graph path).
VITE_GRAPH_GATEWAY_KEY=

# Optional. When unset the app uses viem's default public Sepolia RPC for the
# ENSv2 reads (UniversalResolverV2) and Arc's public testnet RPC.
VITE_SEPOLIA_RPC=
VITE_ARC_TESTNET_RPC=

# One-world demo buyer (T13): the key that signs client actions (buy/settle) in
# the console and is the SlaHook's attester on our escrow instance (0x967e…).
# Provisioned by `scripts/openbook-demo-setup.ts` into `.env` and
# `app/.env.local`. VITE_ only exposes the KEY to the client bundle; the raw
# DEMO_BUYER_PK / OPENBOOK_ATTESTER_PK live in `.env` for the CLIs.
VITE_DEMO_BUYER_KEY=
VITE_DEMO_BUYER_ADDRESS=

# Console ask mode — the LLM proposes a registry command + argv, the registry
# executes; the model NEVER emits data (receipts stay live reads). Optional:
# unset -> the mode chip reads "ask: set VITE_LLM_API_KEY" and every command
# still works (the suggested-command chips are static mappings, keyless).
# Endpoint must speak the OpenAI chat-completions protocol (POST
# /chat/completions, response_format json_object). Default model is cheap and
# fast; OpenRouter keys work as-is.
VITE_LLM_BASE_URL=https://openrouter.ai/api/v1
VITE_LLM_API_KEY=
VITE_LLM_MODEL=deepseek/deepseek-chat
